#!/bin/bash
# Begrüßung nach dem Login: AdGuard-Logo + Systemstatus

# Farbdefinitionen (ANSI - AdGuard Theme)
LIGHT_GREEN='\033[1;32m'
DARK_GREEN='\033[0;32m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'
GRAY='\033[0;90m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m'

LINE="${LIGHT_GREEN}=====================================================================${NC}"

# Farbe nach Auslastung: grün / gelb ab $2 / rot ab $3
level_color() {
    if   (( $1 >= $3 )); then echo "$RED"
    elif (( $1 >= $2 )); then echo "$YELLOW"
    else                      echo "$LIGHT_GREEN"
    fi
}

# Balken mit 20 Zeichen, z.B. [██████░░░░░░░░░░░░░░]
bar() {
    local pct=$1 color=$2 width=20 filled
    filled=$(( pct * width / 100 ))
    printf '%b[' "$GRAY"
    printf '%b' "$color"; printf '%*s' "$filled" '' | sed 's/ /█/g'
    printf '%b' "$GRAY";  printf '%*s' "$(( width - filled ))" '' | sed 's/ /░/g'
    printf ']%b' "$NC"
}

# ------------------------------------------------------------ Systemdaten
HOSTNAME=$(hostname)
MODEL=$(cat /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/product_name 2>/dev/null | tr '\n' ' ' | sed 's/ *$//')
# Projektversion, mit der das Gerät installiert wurde (von build-iso.sh)
SETUP_VERSION=$(head -n1 /opt/adguard-setup/VERSION 2>/dev/null)
OS=$(. /etc/os-release && echo "$PRETTY_NAME")
KERNEL=$(uname -r)
UPTIME=$(uptime -p | sed 's/^up //; s/weeks\?/Wo./; s/days\?/Tg./; s/hours\?/Std./; s/minutes\?/Min./')
IP_ADDR=$(hostname -I | awk '{print $1}')
CPU_LOAD=$(awk '{print $1", "$2", "$3}' /proc/loadavg)

RAM_TOTAL_MB=$(awk '/^MemTotal:/     {printf "%d", $2/1024}' /proc/meminfo)
RAM_AVAIL_MB=$(awk '/^MemAvailable:/ {printf "%d", $2/1024}' /proc/meminfo)
RAM_USED_MB=$(( RAM_TOTAL_MB - RAM_AVAIL_MB ))
RAM_PCT=$(( RAM_USED_MB * 100 / RAM_TOTAL_MB ))
RAM_TEXT=$(awk -v u="$RAM_USED_MB" -v t="$RAM_TOTAL_MB" 'BEGIN {printf "%.1f / %.1f GB", u/1024, t/1024}')

read -r DISK_TOTAL DISK_USED DISK_PCT < <(df -h --output=size,used,pcent / | awk 'NR==2 {gsub("%","",$3); print $1, $2, $3}')

# CPU-Temperatur (höchster Wert aller Thermalzonen)
TEMP=""
if compgen -G "/sys/class/thermal/thermal_zone*/temp" >/dev/null; then
    TEMP=$(cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null | sort -n | tail -1)
    TEMP=$(( TEMP / 1000 ))
fi

# Regelmäßiger Neustart (eingerichtet mit adguard-setup)
REBOOT_PLAN="${YELLOW}nicht eingerichtet${NC}"
if systemctl is-enabled --quiet adguard-reboot.timer 2>/dev/null; then
    REBOOT_PLAN="$(systemctl show -p Description --value adguard-reboot.timer)"
    REBOOT_PLAN="${REBOOT_PLAN#Neustart }"
fi

# Automatische Updates: aktiv? Wann zuletzt gelaufen?
UU_ENABLED=0
eval "$(apt-config shell UU_ENABLED APT::Periodic::Unattended-Upgrade 2>/dev/null)"
UU_STAMP=/var/lib/apt/periodic/unattended-upgrades-stamp
if [[ $UU_ENABLED != 1 ]]; then
    AUTO_UPDATE="${RED}deaktiviert${NC}"
elif [[ -f $UU_STAMP ]]; then
    AUTO_UPDATE="${LIGHT_GREEN}aktiv${NC} ${GRAY}–${NC} ${CYAN}zuletzt $(date -r "$UU_STAMP" '+%d.%m.%Y %H:%M')${NC}"
else
    AUTO_UPDATE="${LIGHT_GREEN}aktiv${NC} ${GRAY}– noch nicht gelaufen (täglich morgens)${NC}"
fi

# Sicherungen der AdGuard-Einstellungen (adguard-backup)
BACKUP_COUNT=$(ls -1 /var/backups/adguard/AdGuardHome-*.yaml 2>/dev/null | wc -l)
if (( BACKUP_COUNT > 0 )); then
    BACKUP_LAST=$(date -r "$(ls -1t /var/backups/adguard/AdGuardHome-*.yaml | head -n1)" '+%d.%m.%Y %H:%M')
    if (( BACKUP_COUNT == 1 )); then BACKUP_WORD="Version"; else BACKUP_WORD="Versionen"; fi
    BACKUP_INFO="${CYAN}zuletzt ${BACKUP_LAST}${NC} ${GRAY}(${BACKUP_COUNT} ${BACKUP_WORD})${NC}"
elif [[ -f /opt/AdGuardHome/AdGuardHome.yaml ]]; then
    BACKUP_INFO="${GRAY}noch keine – erfolgt täglich automatisch bei Änderungen${NC}"
else
    BACKUP_INFO="${GRAY}–${NC}"
fi

# Web-Konsole (Cockpit), falls installiert
WEBCONSOLE=""
systemctl is-enabled --quiet cockpit.socket 2>/dev/null && WEBCONSOLE="https://${IP_ADDR}:9090"

# AdGuard-Status
if systemctl is-active --quiet AdGuardHome 2>/dev/null; then
    AGH_STATE="${LIGHT_GREEN}● läuft${NC}"
else
    AGH_STATE="${RED}● gestoppt${NC}"
fi
AGH_VERSION=$(/opt/AdGuardHome/AdGuardHome --version 2>/dev/null | grep -oE 'v[0-9][0-9.]*' | head -1)
if [[ -f /opt/AdGuardHome/AdGuardHome.yaml ]]; then
    AGH_URL="http://${IP_ADDR}"
else
    AGH_URL="http://${IP_ADDR}:3000  ${YELLOW}(Ersteinrichtung offen)${NC}"
fi

# Uhrzeit per NTP synchronisiert? (falsche Uhrzeit lässt HTTPS/DoH scheitern)
TIME_SYNC=$(timedatectl show -p NTPSynchronized --value 2>/dev/null)

RAM_COLOR=$(level_color "$RAM_PCT" 65 85)
DISK_COLOR=$(level_color "$DISK_PCT" 75 90)

# ------------------------------------------------------------ Ausgabe
echo -e "${LIGHT_GREEN}    ___       ________                     __   __  __                   "
echo -e "${LIGHT_GREEN}   /   | ____/ / ______  ______ __________/ /  / / / ____  ____ ___  ___ "
echo -e "${DARK_GREEN}  / /| |/ __  / / __/ / / / __ \`/ ___/ __  /  / /_/ / __ \\/ __ \`__ \\/ _ \\"
echo -e "${DARK_GREEN} / ___ / /_/ / /_/ / /_/ / /_/ / /  / /_/ /  / __  / /_/ / / / / / /  __/"
echo -e "${LIGHT_GREEN}/_/  |_\\__,_/\\____/\\__,_/\\__,_/_/   \\__,_/  /_/ /_/\\____/_/ /_/ /_/\\___/${NC}"
echo ""
echo -e "$LINE"
# Wochentag fest auf Deutsch (MOTD läuft nicht zwingend mit deutscher Locale)
WEEKDAYS=(Sonntag Montag Dienstag Mittwoch Donnerstag Freitag Samstag)
echo -e " ${WHITE}SYSTEMSTATUS${NC} ${GRAY}– ${WEEKDAYS[$(date +%w)]}, $(date '+%d.%m.%Y %H:%M')${NC}"
if [[ $TIME_SYNC != yes ]]; then
    echo -e " ${RED}Uhrzeit nicht synchronisiert!${NC} ${GRAY}Prüfen mit: timedatectl${NC}"
fi
echo -e "$LINE"
echo -e "  ${BLUE}Hostname:${NC}      ${CYAN}$HOSTNAME${NC}"
[[ -n $MODEL ]] && echo -e "  ${BLUE}Gerät:${NC}         ${CYAN}$MODEL${NC}"
[[ -n $SETUP_VERSION ]] && echo -e "  ${BLUE}Installiert:${NC}   ${CYAN}AdGuard-Wyse3040 $SETUP_VERSION${NC}"
echo -e "  ${BLUE}System:${NC}        ${CYAN}$OS${NC} ${GRAY}(Kernel $KERNEL)${NC}"
echo -e "  ${BLUE}Laufzeit:${NC}      ${CYAN}$UPTIME${NC}"
echo -e "  ${BLUE}IPv4-Adresse:${NC}  ${CYAN}$IP_ADDR${NC}"
echo ""
echo -e "  ${BLUE}CPU-Last:${NC}      ${CYAN}$CPU_LOAD${NC}${TEMP:+   ${GRAY}Temperatur:${NC} ${CYAN}${TEMP} °C${NC}}"
echo -e "  ${BLUE}RAM:${NC}           $(bar "$RAM_PCT" "$RAM_COLOR") ${RAM_COLOR}${RAM_PCT}%${NC}  ${GRAY}${RAM_TEXT}${NC}"
echo -e "  ${BLUE}Speicher:${NC}      $(bar "$DISK_PCT" "$DISK_COLOR") ${DISK_COLOR}${DISK_PCT}%${NC}  ${GRAY}${DISK_USED} / ${DISK_TOTAL}${NC}"
echo ""
echo -e "  ${BLUE}AdGuard Home:${NC}  ${AGH_STATE} ${GRAY}${AGH_VERSION}${NC}"
echo -e "  ${BLUE}Webinterface:${NC}  ${CYAN}${AGH_URL}${NC}"
[[ -n $WEBCONSOLE ]] && echo -e "  ${BLUE}Web-Konsole:${NC}   ${CYAN}${WEBCONSOLE}${NC}"
echo ""
echo -e "  ${BLUE}Auto-Update:${NC}   ${AUTO_UPDATE}"
echo -e "  ${BLUE}Auto-Neustart:${NC} ${CYAN}${REBOOT_PLAN}${NC}"
echo -e "  ${BLUE}Backup:${NC}        ${BACKUP_INFO}"
echo -e "$LINE"

if [[ ! -f /var/lib/adguard-setup/setup.done ]]; then
    echo -e "  ${YELLOW}Tipp:${NC} Hostname und feste IP einrichten mit:  ${WHITE}sudo adguard-setup${NC}"
    echo -e "$LINE"
fi

echo -e "  ${YELLOW}Befehle:${NC}"
echo -e "    ${WHITE}status${NC}               ${GRAY}diese Übersicht erneut anzeigen${NC}"
echo -e "    ${WHITE}sudo adguard-setup${NC}   ${GRAY}Hostname, Passwort, Neustart-Plan, Cockpit, DHCP/feste IP${NC}"
echo -e "    ${WHITE}sudo adguard-backup${NC}  ${GRAY}Backups anzeigen, wiederherstellen, auf USB-Stick sichern${NC}"
echo -e "$LINE"

echo -e "  ${YELLOW}HINWEIS:${NC} ${WHITE}Änderungen am System nur vornehmen, wenn Sie dazu${NC}"
echo -e "  ${WHITE}berechtigt sind und das nötige Fachwissen besitzen.${NC}"
echo -e "$LINE"
